{
  "name": "soul",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.12.0",
  "type": "module",
  "description": "Local-first identity and policy runtime for AI tools",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:companion": "node browser/build.mjs",
    "build:sidecars": "node scripts/prepare-sidecars.mjs --target x86_64-pc-windows-msvc",
    "build:sidecars:debug": "node scripts/prepare-sidecars.mjs --debug --target x86_64-pc-windows-msvc",
    "package:companion": "node scripts/package-companion.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ browser/src/",
    "lint:fix": "eslint src/ browser/src/ --fix",
    "format": "prettier --check src/",
    "format:write": "prettier --write src/",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1 -Target x86_64-pc-windows-msvc",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "soul-schema": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
